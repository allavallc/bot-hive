# Enforce LF line endings across the repo. Eliminates Windows CRLF churn
# that was breaking `biome check` (formatter expects LF).
* text=auto eol=lf

# Binary files — let git handle as-is
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Per-actor event logs at hive/events/<actor>.log. Each actor only ever
# writes to their own file, so cross-actor textual conflicts can't happen
# at all — but we keep merge=union as a safety net for the rare case of
# two writes from the same actor in different PR branches.
hive/events/*.log merge=union

# Legacy single-file log — frozen, kept for historical entries that
# pre-date the per-actor split. New writes go to hive/events/.
hive/events.log merge=union
