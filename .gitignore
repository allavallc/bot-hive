# Dependencies
node_modules/
.pnp
.pnp.js

# Per-bot git worktrees — each spawned bot lives in its own subdirectory
# under worktrees/ for filesystem isolation. Local-only.
worktrees/

# Next.js
.next/
out/
build/

# Production / build artifacts
*.tsbuildinfo
next-env.d.ts

# Environment
.env
.env.local
.env.*.local
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage
coverage/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code per-project state — directory is local, but settings.json
# is committed so the FS-028 UserPromptSubmit hook ships with the repo.
.claude/
!.claude/settings.json

# Per-bot identity file (ADR-003) — local-only; each checkout writes its own
.bot-hive-identity

# HV-129 kickoff marker — one-shot signal written by Add-a-Bot spawn flow,
# consumed and deleted by bot-startup.md step 4. Never committed.
.bot-hive-kickoff

# FS-028 seat-assignment per-session state. Cache file used by
# scripts/check-role.{sh,ps1} to detect mid-session role changes; PID file
# tracks the background heartbeat process so shutdown can kill it. Both
# are worktree-local and recreated on every boot.
.bot-hive-role-cache
.bot-hive-heartbeat.pid

# HV-136 SSE listener runtime state and diagnostic log. Worktree-local;
# never committed.
# Per-bot text logs (activity + events). Persists between sessions; never committed.
logs/

.bot-hive-stream.pid
.bot-hive-role-notice
.bot-hive-role-bootannounced
.bot-hive-role-ptr
.bot-hive-startups/
.bot-hive.log
.bot-hive-session-active

# Local-only override for the Bot Hive API base URL. Useful when testing
# terminal agents against localhost instead of production.
.bot-hive-api-url

# other things
improving-agents.md
startup-coding-humans.md

# Knowledge graph output — generated, never committed.
graphify-out/
src/graphify-out/

# Editor / tool state
.codex/
.dev-server.log