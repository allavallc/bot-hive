{
  "_comment": "Merge this fragment into ~/.claude/settings.json, preserving existing hook entries. See sibling README.md for instructions.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.claude\\hooks\\never-guess-pretool.ps1\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.claude\\hooks\\never-guess-stop.ps1\""
          }
        ]
      }
    ]
  }
}
