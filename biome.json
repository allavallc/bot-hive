{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      ".next",
      ".next-linux",
      ".next-win32",
      "drizzle",
      "build",
      "out",
      "next-env.d.ts",
      "worktrees",
      "graphify",
      "graphify-out",
      ".bot-hive-startups",
      ".codex",
      "logs",
      ".dev-server.log",
      ".bot-hive-api-url",
      ".bot-hive-session-active",
      ".graphify_ast.json",
      ".graphify_detect.json"
    ]
  }
}
